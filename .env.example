# Lingo runtime settings. Bun loads .env from the working directory; docker compose passes it to the container.
# Leave a setting commented out to use its default: an empty value (e.g. `LINGO_PUBLIC_ORIGIN=`) is invalid and stops startup.
# There is no password setting: on first start Lingo logs a one-time setup URL for creating the admin account.

# Bind address and port. Defaults: 127.0.0.1 and 3000. (The Docker image sets 0.0.0.0/3000 itself.)
# LINGO_HOST=127.0.0.1
# LINGO_PORT=3000

# SQLite database. Default: local/lingo.sqlite (the Docker image uses /data/lingo.sqlite).
# LINGO_DB_PATH=/var/lib/lingo/lingo.sqlite

# Exact HTTPS origin users open. Required behind a TLS reverse proxy (origin checks, Secure cookies)
# and for Web Push anywhere but localhost.
# LINGO_PUBLIC_ORIGIN=https://irc.example.com

# 1 only behind a reverse proxy that appends the client address to X-Forwarded-For (used for login rate limits).
# LINGO_TRUST_PROXY=1

# Delete history older than this many days (1–3650). Unset keeps history forever; admins can override per user.
# LINGO_HISTORY_RETENTION_DAYS=365

# File uploads through a teacup instance. URL, username, and password turn the feature on together.
# LINGO_TEACUP_URL=http://127.0.0.1:8080
# LINGO_TEACUP_USERNAME=lingo
# LINGO_TEACUP_PASSWORD=change-me
# Base of links posted to IRC (https: unless localhost). Default: LINGO_TEACUP_URL.
# LINGO_TEACUP_PUBLIC_URL=https://files.example.com
# Per-file limit in MiB (1–500). Default: 25.
# LINGO_UPLOAD_MAX_MB=25
