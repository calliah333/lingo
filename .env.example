# Required: password used to authenticate to the bouncer.
LINGO_PASSWORD=change-me

# Optional: SQLite database path (defaults to the application's local data path).
# LINGO_DB_PATH=./local/lingo.sqlite

# Optional: bind address and HTTP port.
# LINGO_HOST=127.0.0.1
# LINGO_PORT=3000

# Optional: exact HTTPS origin when served behind a TLS reverse proxy.
# LINGO_PUBLIC_ORIGIN=https://irc.example.com
